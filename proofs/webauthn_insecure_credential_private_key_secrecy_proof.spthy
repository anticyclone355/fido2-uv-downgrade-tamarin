theory FIDO2_UV_Downgrade_AuthFocused begin

// Function signature and definition of the equational theory E

functions: fst/1, h/1, hmac/2, pair/2, pk/1, sign/2, snd/1, true/0,
           verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true









rule (modulo E) Provision_Registered_Credential:
   [ Fr( ~credentialId ), Fr( ~credentialKey ), Fr( ~pin ) ]
  --[
  CredentialProvisioned( ~credentialId, pk(~credentialKey) ),
  PINProvisioned( ~pin ), SecretCredentialKey( ~credentialKey ),
  SecretPIN( ~pin )
  ]->
   [
   !RPRegisteredCredential( ~credentialId, pk(~credentialKey) ),
   !AuthenticatorCredential( ~credentialId, ~credentialKey ),
   !AuthenticatorPIN( ~pin )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) RP_Send_M5_Insecure:
   [
   !RPRegisteredCredential( credentialId, credentialPublicKey ),
   Fr( ~challenge )
   ]
  --[
  RPAuthenticationChallengeSent( credentialId, ~challenge, 'required' ),
  RunningRPAuthContext( credentialId,
                        h(<'webauthn_get', ~challenge, 'origin'>), 'user_verified'
  ),
  WebAuthnChannelSent( 'M5', 'required', 'insecure' )
  ]->
   [
   St_RP_AuthPending( ~challenge, credentialId, credentialPublicKey,
                      'required'
   ),
   Out( <'wa_m5', ~challenge, credentialId, 'required'> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Browser_Prepare_Required_Insecure:
   [ In( <'wa_m5', challenge, credentialId, 'required'> ) ]
  --[
  WebAuthnChannelDelivered( 'M5', 'required', 'insecure' ),
  BrowserAuthenticationPrepared( credentialId, challenge, 'required',
                                 'true'
  )
  ]->
   [
   St_Browser_NeedGAToken( challenge, credentialId,
                           <'webauthn_get', challenge, 'origin'>,
                           h(<'webauthn_get', challenge, 'origin'>)
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Browser_Prepare_Discouraged_Insecure:
   [ In( <'wa_m5', challenge, credentialId, 'discouraged'> ) ]
  --[
  WebAuthnChannelDelivered( 'M5', 'discouraged', 'insecure' ),
  BrowserAuthenticationPrepared( credentialId, challenge, 'discouraged',
                                 'false'
  )
  ]->
   [
   St_Browser_NoUV( challenge, credentialId,
                    <'webauthn_get', challenge, 'origin'>,
                    h(<'webauthn_get', challenge, 'origin'>)
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Browser_Acquire_GA_UV_Token:
   [
   St_Browser_NeedGAToken( challenge, credentialId, clientData, clientHash
   ),
   !AuthenticatorPIN( pin ), Fr( ~token )
   ]
  --[
  PINVerified( pin ),
  UVAuthorizedForSession( 'rp_id', clientHash, 'ga', ~token ),
  AuthenticatorUVPerformed( credentialId ),
  TokenIssued( ~token, 'ga', 'rp_id' ), SecretToken( ~token )
  ]->
   [
   St_Browser_HaveGAToken( challenge, credentialId, clientData, clientHash,
                           ~token
   ),
   St_ValidGAToken( ~token, 'rp_id' )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Browser_Send_GA_WithUV_Secure:
   [
   St_Browser_HaveGAToken( challenge, credentialId, clientData, clientHash,
                           token
   )
   ]
  --[
  BrowserGetAssertionSent( credentialId, clientHash, 'token' ),
  RunningBrowserAuthContext( credentialId, clientHash, 'user_verified' ),
  BrowserPinUvAuthParamSent( credentialId, clientHash,
                             hmac(token, clientHash)
  ),
  CTAPChannelSent( 'GA_UV', 'secure' )
  ]->
   [
   St_Browser_AwaitAssertion( challenge, credentialId, clientData,
                              clientHash
   ),
   Sec_CTAP_GAUV( credentialId, clientHash, hmac(token, clientHash) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Authenticator_GA_WithUV_Secure:
   [
   St_ValidGAToken( token, 'rp_id' ),
   !AuthenticatorCredential( credentialId, credentialKey ),
   Sec_CTAP_GAUV( credentialId, clientHash, hmac(token, clientHash) )
   ]
  --[
  CTAPChannelDelivered( 'GA_UV', 'secure' ),
  AuthenticatorGetAssertionAuthorized( credentialId, clientHash, 'token',
                                       'true'
  ),
  CommitAuthenticatorUV( 'rp_id', clientHash, 'ga', token ),
  CommitAuthenticatorAuthContext( credentialId, clientHash, 'user_verified'
  ),
  AuthenticatorPinUvAuthParamAccepted( credentialId, clientHash,
                                       hmac(token, clientHash)
  ),
  AssertionSigned( credentialId, credentialKey, clientHash, 'true' ),
  CommitAuthenticatorAuthContext( credentialId, clientHash, 'user_verified'
  )
  ]->
   [
   Sec_CTAP_GAResp( credentialId,
                    <'auth_data', h('rp_id'), 'true', 'true', 'zero'>,
                    sign(<<'auth_data', h('rp_id'), 'true', 'true', 'zero'>, clientHash>,
                         credentialKey)
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Browser_Send_GA_WithoutUV_Secure:
   [ St_Browser_NoUV( challenge, credentialId, clientData, clientHash ) ]
  --[
  BrowserGetAssertionSent( credentialId, clientHash, 'no_uv' ),
  RunningBrowserAuthContext( credentialId, clientHash, 'presence_only' ),
  CTAPChannelSent( 'GA_NOUV', 'secure' )
  ]->
   [
   St_Browser_AwaitAssertion( challenge, credentialId, clientData,
                              clientHash
   ),
   Sec_CTAP_GANoUV( credentialId, clientHash )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Authenticator_GA_WithoutUV_Secure:
   [
   !AuthenticatorCredential( credentialId, credentialKey ),
   Sec_CTAP_GANoUV( credentialId, clientHash )
   ]
  --[
  CTAPChannelDelivered( 'GA_NOUV', 'secure' ),
  AuthenticatorGetAssertionAuthorized( credentialId, clientHash,
                                       'no_token', 'false'
  ),
  AssertionSigned( credentialId, credentialKey, clientHash, 'false' ),
  CommitAuthenticatorAuthContext( credentialId, clientHash, 'presence_only'
  )
  ]->
   [
   Sec_CTAP_GAResp( credentialId,
                    <'auth_data', h('rp_id'), 'true', 'false', 'zero'>,
                    sign(<<'auth_data', h('rp_id'), 'true', 'false', 'zero'>, clientHash>,
                         credentialKey)
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Browser_Receive_GA_Response_Secure:
   [
   St_Browser_AwaitAssertion( challenge, credentialId, clientData,
                              clientHash
   ),
   Sec_CTAP_GAResp( credentialId, authData, signature )
   ]
  --[ CTAPChannelDelivered( 'GA_RESP', 'secure' ) ]->
   [
   St_Browser_HaveAssertion( challenge, credentialId, clientData,
                             clientHash, authData, signature
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Browser_Send_M8_Insecure:
   [
   St_Browser_HaveAssertion( challenge, credentialId, clientData,
                             clientHash, authData, signature
   )
   ]
  --[
  BrowserAuthenticationM8Sent( credentialId, challenge ),
  WebAuthnChannelSent( 'M8', 'response', 'insecure' )
  ]->
   [ Out( <'wa_m8', clientData, credentialId, authData, signature> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) RP_Accept_M8_Insecure:
   [
   St_RP_AuthPending( challenge, credentialId, credentialPublicKey,
                      'required'
   ),
   In( <'wa_m8', <'webauthn_get', challenge, 'origin'>, credentialId, 
        <'auth_data', h('rp_id'), 'true', 'true', 'zero'>, signature>
   )
   ]
  --[
  WebAuthnChannelDelivered( 'M8', 'response', 'insecure' ),
  Eq( verify(signature,
             <<'auth_data', h('rp_id'), 'true', 'true', 'zero'>, 
              h(<'webauthn_get', challenge, 'origin'>)>,
             credentialPublicKey),
      true
  ),
  RPAuthenticationAccepted( credentialId,
                            h(<'webauthn_get', challenge, 'origin'>), 'true'
  )
  ]->
   [ St_RP_Accepted( credentialId ) ]

  /*
  rule (modulo AC) RP_Accept_M8_Insecure:
     [
     St_RP_AuthPending( challenge, credentialId, credentialPublicKey,
                        'required'
     ),
     In( <'wa_m8', <'webauthn_get', challenge, 'origin'>, credentialId, 
          <'auth_data', h('rp_id'), 'true', 'true', 'zero'>, signature>
     )
     ]
    --[
    WebAuthnChannelDelivered( 'M8', 'response', 'insecure' ), Eq( z, true ),
    RPAuthenticationAccepted( credentialId,
                              h(<'webauthn_get', challenge, 'origin'>), 'true'
    )
    ]->
     [ St_RP_Accepted( credentialId ) ]
    variants (modulo AC)
    1. challenge
             = challenge.21
       credentialPublicKey
             = credentialPublicKey.23
       signature
             = signature.24
       z     = verify(signature.24,
                      <<'auth_data', h('rp_id'), 'true', 'true', 'zero'>, 
                       h(<'webauthn_get', challenge.21, 'origin'>)>,
                      credentialPublicKey.23)
    
    2. challenge
             = challenge.180
       credentialPublicKey
             = pk(x.358)
       signature
             = sign(<<'auth_data', h('rp_id'), 'true', 'true', 'zero'>, 
                     h(<'webauthn_get', challenge.180, 'origin'>)>,
                    x.358)
       z     = true
  */

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

lemma executable_authentication:
  exists-trace
  "∃ credentialId credentialKey clientHash #i #j #k.
    ((((CredentialProvisioned( credentialId, pk(credentialKey) ) @ #i) ∧
       (AssertionSigned( credentialId, credentialKey, clientHash, 'true'
        ) @ #j)) ∧
      (RPAuthenticationAccepted( credentialId, clientHash, 'true' ) @ #k)) ∧
     (#i < #j)) ∧
    (#j < #k)"
/*
guarded formula characterizing all satisfying traces:
"∃ credentialId credentialKey clientHash #i #j #k.
  (CredentialProvisioned( credentialId, pk(credentialKey) ) @ #i) ∧
  (AssertionSigned( credentialId, credentialKey, clientHash, 'true'
   ) @ #j) ∧
  (RPAuthenticationAccepted( credentialId, clientHash, 'true' ) @ #k)
 ∧
  (#i < #j) ∧ (#j < #k)"
*/
by sorry

lemma rp_required_uv_acceptance:
  all-traces
  "∀ credentialId clientHash uv #i.
    (RPAuthenticationAccepted( credentialId, clientHash, uv ) @ #i) ⇒
    (uv = 'true')"
/*
guarded formula characterizing all counter-examples:
"∃ credentialId clientHash uv #i.
  (RPAuthenticationAccepted( credentialId, clientHash, uv ) @ #i)
 ∧
  ¬(uv = 'true')"
*/
by sorry

lemma credential_private_key_secrecy:
  all-traces
  "∀ credentialKey #i.
    (SecretCredentialKey( credentialKey ) @ #i) ⇒
    (¬(∃ #j. K( credentialKey ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ credentialKey #i.
  (SecretCredentialKey( credentialKey ) @ #i)
 ∧
  ∃ #j. (K( credentialKey ) @ #j)"
*/
simplify
by solve( !KU( ~credentialKey ) @ #vk )

lemma pin_secrecy:
  all-traces "∀ pin #i. (SecretPIN( pin ) @ #i) ⇒ (¬(∃ #j. K( pin ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ pin #i. (SecretPIN( pin ) @ #i) ∧ ∃ #j. (K( pin ) @ #j)"
*/
by sorry

lemma ga_token_secrecy:
  all-traces
  "∀ token #i. (SecretToken( token ) @ #i) ⇒ (¬(∃ #j. K( token ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ token #i. (SecretToken( token ) @ #i) ∧ ∃ #j. (K( token ) @ #j)"
*/
by sorry

lemma pin_authorizes_token_issuance:
  all-traces
  "∀ token #i.
    (TokenIssued( token, 'ga', 'rp_id' ) @ #i) ⇒
    (∃ pin. PINVerified( pin ) @ #i)"
/*
guarded formula characterizing all counter-examples:
"∃ token #i.
  (TokenIssued( token, 'ga', 'rp_id' ) @ #i)
 ∧
  ∀ pin. (PINVerified( pin ) @ #i) ⇒ ⊥"
*/
by sorry

lemma noninjective_agreement_authentication_context:
  all-traces
  "∀ credentialId clientHash authContext #commit.
    (CommitAuthenticatorAuthContext( credentialId, clientHash, authContext
     ) @ #commit) ⇒
    (∃ #rp #browser.
      (((RunningRPAuthContext( credentialId, clientHash, authContext ) @ #rp) ∧
        (RunningBrowserAuthContext( credentialId, clientHash, authContext
         ) @ #browser)) ∧
       (#rp < #browser)) ∧
      (#browser < #commit))"
/*
guarded formula characterizing all counter-examples:
"∃ credentialId clientHash authContext #commit.
  (CommitAuthenticatorAuthContext( credentialId, clientHash, authContext
   ) @ #commit)
 ∧
  ∀ #rp #browser.
   (RunningRPAuthContext( credentialId, clientHash, authContext ) @ #rp) ∧
   (RunningBrowserAuthContext( credentialId, clientHash, authContext
    ) @ #browser)
  ⇒
   ((¬(#rp < #browser)) ∨ (¬(#browser < #commit)))"
*/
by sorry

lemma injective_agreement_authentication_context:
  all-traces
  "∀ credentialId clientHash authContext #commit.
    (CommitAuthenticatorAuthContext( credentialId, clientHash, authContext
     ) @ #commit) ⇒
    (∃ #rp #browser.
      ((((RunningRPAuthContext( credentialId, clientHash, authContext
          ) @ #rp) ∧
         (RunningBrowserAuthContext( credentialId, clientHash, authContext
          ) @ #browser)) ∧
        (#rp < #browser)) ∧
       (#browser < #commit)) ∧
      (¬(∃ #commit2.
          (CommitAuthenticatorAuthContext( credentialId, clientHash, authContext
           ) @ #commit2) ∧
          (¬(#commit2 = #commit)))))"
/*
guarded formula characterizing all counter-examples:
"∃ credentialId clientHash authContext #commit.
  (CommitAuthenticatorAuthContext( credentialId, clientHash, authContext
   ) @ #commit)
 ∧
  ∀ #rp #browser.
   (RunningRPAuthContext( credentialId, clientHash, authContext ) @ #rp) ∧
   (RunningBrowserAuthContext( credentialId, clientHash, authContext
    ) @ #browser)
  ⇒
   ((¬(#rp < #browser)) ∨
    (¬(#browser < #commit)) ∨
    (∃ #commit2.
      (CommitAuthenticatorAuthContext( credentialId, clientHash, authContext
       ) @ #commit2)
     ∧
      ¬(#commit2 = #commit)))"
*/
by sorry

lemma authentication_context_consistency:
  all-traces
  "∀ credentialId clientHash expectedContext actualContext #rp #auth.
    (((RunningRPAuthContext( credentialId, clientHash, expectedContext
       ) @ #rp) ∧
      (CommitAuthenticatorAuthContext( credentialId, clientHash, actualContext
       ) @ #auth)) ∧
     (#rp < #auth)) ⇒
    (expectedContext = actualContext)"
/*
guarded formula characterizing all counter-examples:
"∃ credentialId clientHash expectedContext actualContext #rp #auth.
  (RunningRPAuthContext( credentialId, clientHash, expectedContext
   ) @ #rp) ∧
  (CommitAuthenticatorAuthContext( credentialId, clientHash, actualContext
   ) @ #auth)
 ∧
  (#rp < #auth) ∧ (¬(expectedContext = actualContext))"
*/
by sorry

lemma authentication_assurance_provenance:
  all-traces
  "∀ clientHash token #auth.
    (CommitAuthenticatorUV( 'rp_id', clientHash, 'ga', token ) @ #auth) ⇒
    (∃ #uv.
      (UVAuthorizedForSession( 'rp_id', clientHash, 'ga', token ) @ #uv) ∧
      (#uv < #auth))"
/*
guarded formula characterizing all counter-examples:
"∃ clientHash token #auth.
  (CommitAuthenticatorUV( 'rp_id', clientHash, 'ga', token ) @ #auth)
 ∧
  ∀ #uv.
   (UVAuthorizedForSession( 'rp_id', clientHash, 'ga', token ) @ #uv)
  ⇒
   ¬(#uv < #auth)"
*/
by sorry



















